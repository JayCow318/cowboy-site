---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-icon">🤠</span>
      <span class="footer-name">Cowboy</span>
    </div>
    <div class="footer-links">
      <a href="https://github.com/cowboy" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
      <span class="footer-dot">·</span>
      <a href="mailto:cowboy@example.com" class="footer-link">Email</a>
    </div>
    <p class="footer-copy">© {year} Cowboy. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-light);
    padding: var(--space-2xl) 0;
    margin-top: var(--space-4xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  .footer-icon {
    font-size: 1.25rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .footer-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-dot {
    color: var(--text-muted);
  }

  .footer-copy {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
</style>
