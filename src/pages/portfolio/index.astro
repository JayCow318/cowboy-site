---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const projects = [
  {
    title: 'Project One',
    description: 'A cool project I built. This is where the description goes — showing what it does and why it matters.',
    tags: ['React', 'TypeScript', 'Astro'],
    url: 'https://github.com/cowboy',
  },
  {
    title: 'Project Two',
    description: 'Another fun project. Maybe it solves a problem or explores an interesting idea.',
    tags: ['Python', 'FastAPI', 'PostgreSQL'],
    url: 'https://github.com/cowboy',
  },
  {
    title: 'Project Three',
    description: 'Yet another creation. This could be a CLI tool, a design system, or anything in between.',
    tags: ['Rust', 'CLI'],
    url: 'https://github.com/cowboy',
  },
];
---

<BaseLayout title="Portfolio">
  <Header />

  <section class="section">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">Portfolio</h1>
        <p class="page-desc">Things I've built and tinkered with.</p>
      </header>

      <div class="divider" />

      <div class="project-grid">
        {projects.map(project => (
          <article class="card project-card">
            <div class="project-body">
              <h3 class="project-title">{project.title}</h3>
              <p class="project-desc">{project.description}</p>
              <div class="project-tags">
                {project.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              {project.url && (
                <a href={project.url} class="project-link" target="_blank" rel="noopener noreferrer">
                  View on GitHub →
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .project-card {
    padding: 0;
    overflow: hidden;
  }

  .project-body {
    padding: var(--space-lg);
  }

  .project-title {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
    transition: color var(--transition);
  }

  .project-card:hover .project-title {
    color: var(--accent);
  }

  .project-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .project-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .page-title { font-size: 1.875rem; }
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
