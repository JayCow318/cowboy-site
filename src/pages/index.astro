---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';

const featuredPosts = [
  {
    title: 'Welcome to My Corner of the Web',
    excerpt: 'Starting a new journey — sharing thoughts, projects, and lessons learned along the way.',
    date: '2026-08-13',
    tags: ['meta', 'personal'],
    url: '/blog/welcome-to-my-site',
  },
];

const featuredProjects = [
  {
    title: 'Project One',
    description: 'A cool project I built. This is where the description goes — showing what it does and why it matters.',
    tags: ['React', 'TypeScript'],
    url: 'https://github.com/JayCow318',
  },
  {
    title: 'Project Two',
    description: 'Another fun project. Maybe it solves a problem or explores an interesting idea.',
    tags: ['Python', 'API'],
    url: 'https://github.com/JayCow318',
  },
];
---

<BaseLayout title="Home">
  <Header />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <p class="hero-greeting">Howdy, I'm</p>
        <h1 class="hero-name">
          Cowboy
          <span class="hero-wave">🤠</span>
        </h1>
        <p class="hero-tagline">
          Builder. Learner. Explorer.
        </p>
        <p class="hero-desc">
          Welcome to my corner of the web. I write about code, design, and the things I'm building.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">Read the Blog</a>
          <a href="/portfolio" class="btn btn-outline">View My Work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Blog Posts -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Latest Posts</h2>
      <div class="post-list">
        {featuredPosts.map(post => (
          <BlogCard {...post} />
        ))}
      </div>
      <div class="section-footer">
        <a href="/blog" class="btn btn-outline">All Posts →</a>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        {featuredProjects.map(project => (
          <PortfolioCard {...project} />
        ))}
      </div>
      <div class="section-footer">
        <a href="/portfolio" class="btn btn-outline">All Projects →</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: var(--space-4xl) 0 var(--space-3xl);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(181, 101, 62, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    max-width: 600px;
    position: relative;
  }

  .hero-greeting {
    font-size: 1.125rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
  }

  .hero-wave {
    display: inline-block;
    font-size: 2.5rem;
    margin-left: 0.5rem;
  }

  .hero-tagline {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .hero-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .section-footer {
    margin-top: var(--space-xl);
    text-align: center;
  }

  @media (max-width: 640px) {
    .hero { padding: var(--space-2xl) 0; }
    .hero-name { font-size: 2.5rem; }
    .hero-wave { font-size: 1.75rem; }
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
