---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About">
  <Header />

  <section class="section">
    <div class="container">

      <header class="page-header">
        <h1 class="page-title">About Me</h1>
      </header>

      <div class="divider" />

      <div class="about-content">
        <div class="about-avatar">🤠</div>

        <div class="about-text prose">
          <h2>Hey there, I'm Cowboy.</h2>

          <p>
            I'm a builder at heart — someone who loves taking ideas from concept to reality.
            Whether it's a web app, a CLI tool, or an experimental side project, I enjoy the
            process of creating things that are both functional and elegant.
          </p>

          <p>
            This site is my little corner of the internet where I share what I'm working on,
            what I've learned, and occasional thoughts about technology and design.
          </p>

          <h3>What I do</h3>
          <ul>
            <li><strong>Build</strong> — Full-stack web development, from frontend to backend</li>
            <li><strong>Write</strong> — Share knowledge and document my journey</li>
            <li><strong>Learn</strong> — Always exploring new tools, languages, and ideas</li>
          </ul>

          <h3>Tech Stack</h3>
          <p>
            I work with a variety of languages and frameworks. Some of my favorites include
            TypeScript, React, Python, and Rust. I'm also a big fan of Astro (which powers this site!).
          </p>

          <h3>Get in Touch</h3>
          <p>
            Want to chat about a project, an idea, or just say hi?
            Feel free to reach out on <a href="https://github.com/JayCow318" target="_blank" rel="noopener noreferrer">GitHub</a>
            {' '}or send me an email at <a href="mailto:jaycow318@gmail.com">jaycow318@gmail.com</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .page-title {
    font-size: 2.5rem;
  }

  .about-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .about-avatar {
    text-align: center;
    font-size: 5rem;
    margin-bottom: var(--space-xl);
    line-height: 1;
  }

  .about-text h2 {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .about-text p {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .page-title { font-size: 1.875rem; }
    .about-avatar { font-size: 3.5rem; }
  }
</style>
