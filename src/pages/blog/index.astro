---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = [
  {
    title: '我的實習生活',
    excerpt: '記錄一下這段時間的實習心得與日常',
    date: '2026-08-17',
    tags: ['實習', '生活', '心得'],
    url: '/blog/internship-life',
    image: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=600&h=300&fit=crop',
  },
  {
    title: 'Welcome to My Corner of the Web',
    excerpt: 'Starting a new journey — sharing thoughts, projects, and lessons learned along the way.',
    date: '2026-08-13',
    tags: ['meta', 'personal'],
    url: '/blog/welcome-to-my-site',
    image: 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=600&h=300&fit=crop',
  },
];
---

<BaseLayout title="部落格">
  <Header />

  <section class="section">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">部落格</h1>
        <p class="page-desc">學習筆記、生活記錄、專案分享</p>
      </header>

      <div class="divider" />

      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map(post => <BlogCard {...post} />)}
        </div>
      ) : (
        <div class="empty-state">
          <p>還沒有文章，敬請期待！</p>
        </div>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl) 0;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  @media (max-width: 640px) {
    .page-title { font-size: 1.875rem; }
  }
</style>
